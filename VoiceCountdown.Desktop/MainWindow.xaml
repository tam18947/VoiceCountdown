<Window x:Class="VoiceCountdown.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VoiceCountdown.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Style="{StaticResource {x:Type Window}}"
        Title="カウントダウン読み上げちゃん"
        Icon="favicon.ico"
        Width="900" Height="560"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding Topmost}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarState, Mode=OneWay}"
                         ProgressValue="{Binding Progress, Mode=OneWay}" />
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== 設定パネル ===================== -->
        <Border Grid.Column="0"
                Width="300"
                Background="{StaticResource PaneBrush}"
                Visibility="{Binding IsSettingsPaneOpen, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,12,20,20">

                    <!-- タイマー -->
                    <TextBlock Text="タイマー" Style="{StaticResource SectionHeader}" Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsIdle}">
                        <RadioButton GroupName="Mode" Content="期間で設定" Margin="0,0,16,0"
                                     IsChecked="{Binding IsDurationMode}" />
                        <RadioButton GroupName="Mode" Content="時刻で設定"
                                     IsChecked="{Binding IsAlarmMode}" />
                    </StackPanel>
                    <TextBox Margin="0,10,0,0"
                             FontSize="20"
                             InputMethod.IsInputMethodEnabled="False"
                             IsEnabled="{Binding IsIdle}"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding InputHint}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding InputError}"
                               Foreground="{StaticResource CriticalBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <!-- よく使う時間 -->
                    <WrapPanel Margin="0,8,0,0"
                               IsEnabled="{Binding IsIdle}"
                               Visibility="{Binding IsDurationMode, Converter={StaticResource BoolToVisibility}}">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Margin" Value="0,0,6,6" />
                                <Setter Property="Padding" Value="10,4" />
                                <Setter Property="Command" Value="{Binding PresetCommand}" />
                            </Style>
                        </WrapPanel.Resources>
                        <Button Content="1分" CommandParameter="1" />
                        <Button Content="3分" CommandParameter="3" />
                        <Button Content="5分" CommandParameter="5" />
                        <Button Content="10分" CommandParameter="10" />
                        <Button Content="15分" CommandParameter="15" />
                        <Button Content="30分" CommandParameter="30" />
                    </WrapPanel>

                    <!-- 読み上げ -->
                    <TextBlock Text="読み上げるタイミング" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Triggers}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TriggerItemViewModel}">
                                <Border CornerRadius="4" Padding="6,0" Margin="0,0,4,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLastTriggered}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 出力デバイス -->
                    <TextBlock Text="出力デバイス" Style="{StaticResource SectionHeader}" />
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DropDownOpened="Devices_DropDownOpened" />

                    <!-- 表示 -->
                    <TextBlock Text="表示" Style="{StaticResource SectionHeader}" />
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding FontFamilies}"
                              SelectedItem="{Binding SelectedFont}"
                              ToolTip="残り時間のフォントを選ぶ">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                    <CheckBox Content="常に手前に表示" Margin="0,10,0,0" IsChecked="{Binding Topmost}" />

                    <!-- 操作 -->
                    <TextBlock Text="キーボード操作" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource CaptionText}" LineHeight="20">
                        Space / Enter：開始・一時停止・再開<LineBreak />
                        Esc：リセット（全画面表示中は全画面を解除）<LineBreak />
                        F11：全画面表示
                    </TextBlock>

                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,20,0,0">
                        音声：<Hyperlink NavigateUri="https://amitaro.net/" RequestNavigate="Hyperlink_RequestNavigate">あみたろの声素材工房</Hyperlink>
                    </TextBlock>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                        <Run Text="{Binding VersionText, Mode=OneWay}" />
                        <Run Text="・" />
                        <Hyperlink NavigateUri="https://github.com/tam18947/VoiceCountdown/releases" RequestNavigate="Hyperlink_RequestNavigate">更新を確認</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================== メイン（残り時間） ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ツールバー -->
            <DockPanel Grid.Row="0" Margin="8,8,12,0" LastChildFill="False">
                <ToggleButton DockPanel.Dock="Left"
                              Style="{StaticResource ToolbarToggleButton}"
                              Content="&#xE700;"
                              ToolTip="設定パネルの表示・非表示"
                              IsChecked="{Binding IsSettingsPaneOpen}" />
                <Button x:Name="FullScreenButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ToolbarPushButton}"
                        Content="&#xE740;"
                        ToolTip="全画面表示 (F11)"
                        Click="FullScreen_Click" />
                <ToggleButton DockPanel.Dock="Right"
                              Style="{StaticResource ToolbarToggleButton}"
                              Content="&#xE718;"
                              ToolTip="常に手前に表示"
                              IsChecked="{Binding Topmost}" />
            </DockPanel>

            <!-- 補足（「15:00 まで」など） -->
            <TextBlock Grid.Row="1"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       Opacity="0.7"
                       Text="{Binding Caption}" />

            <!-- 残り時間：ウィンドウの大きさに合わせて拡大縮小する -->
            <Viewbox Grid.Row="2" Margin="32,0" Stretch="Uniform">
                <TextBlock Text="{Binding DisplayText}"
                           FontFamily="{Binding DisplayFontFamily}"
                           FontSize="120"
                           FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:TimeLevel.Warning}">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:TimeLevel.Critical}">
                                    <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="FinishedBlink">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.15"
                                                                 Duration="0:0:0.5"
                                                                 AutoReverse="True"
                                                                 RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="FinishedBlink" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Viewbox>

            <!-- 残り時間の割合 -->
            <ProgressBar Grid.Row="3"
                         Height="4"
                         Margin="32,0,32,16"
                         Minimum="0" Maximum="1"
                         Value="{Binding Progress, Mode=OneWay}" />

            <!-- 開始・一時停止 / リセット -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                <Button Style="{StaticResource RoundButton}"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0"
                        Content="&#xE71A;"
                        ToolTip="リセット (Esc)"
                        Command="{Binding ResetCommand}" />
                <Button Style="{StaticResource PrimaryRoundButton}"
                        Content="{Binding StartPauseGlyph}"
                        ToolTip="{Binding StartPauseLabel}"
                        Command="{Binding StartPauseCommand}" />
                <!-- 左右のバランスを取るための余白 -->
                <Border Width="56" Margin="20,0,0,0" />
            </StackPanel>

            <!-- エラーなどの通知 -->
            <TextBlock Grid.Row="5"
                       Margin="16,0,16,8"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource CriticalBrush}"
                       Text="{Binding StatusMessage}" />
        </Grid>
    </Grid>
</Window>
